{
  "name": "impostor-volleyball",
  "version": "0.2.0",
  "private": true,
  "description": "Fan-made volleyball game prototype",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop": "electron .",
    "dist:win": "npm run build && electron-builder --win portable",
    "server": "node server/index.mjs"
  },
  "dependencies": {
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.seden.impostorvolleyball",
    "productName": "Impostor Volleyball",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": [{ "target": "portable", "arch": ["x64"] }] }
  }
}